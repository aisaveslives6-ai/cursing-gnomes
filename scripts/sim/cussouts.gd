## --- helpers ---------------------------------------------------------------

## Total templates for a voice across all tiers.
static func pool_size(voice: String) -> int:
	var v: Dictionary = POOLS.get(voice, POOLS["neutral"])
	var n := 0
	for t in TIERS:
		n += (v.get(t, []) as Array).size()
	return n


## Tier template count for a voice.
static func tier_size(voice: String, tier: String) -> int:
	var v: Dictionary = POOLS.get(voice, POOLS["neutral"])
	return ((v.get(tier, []) as Array)).size()


## All voice keys.
static func voices() -> Array:
	return POOLS.keys()


## Fill slots in a template.
static func fill(text: String, ruler: String, npc_name: String,
		faction: String) -> String:
	var r := ruler
	if r == "":
		r = "ruler"
	return text.replace("{ruler}", r).replace("{name}", npc_name)\
		.replace("{faction}", faction)
