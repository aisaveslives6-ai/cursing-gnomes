static var _phrase_re: RegEx = null


## Escape a literal for embedding in a regex alternation.
static func _rx_escape(s: String) -> String:
	var out := s
	for c in ["\\", "^", "$", ".", "|", "?", "*", "+", "(", ")", "[", "]",
			"{", "}"]:
		out = out.replace(c, "\\" + c)
	return out


## Normalize like HTML _ctNorm: lowercase, fold curly apostrophes,
## strip apostrophes, non-alphanumerics to spaces.
static func _norm(s: String) -> String:
	var t := s.to_lower()
	for c in ["‘", "’", "ʼ", "‛", "′", "`", "´"]:
		t = t.replace(c, "'")
	t = t.replace("'", "")
	var rx := RegEx.new()
	rx.compile("[^a-z0-9 ]+")
	t = rx.sub(t, " ", true)
	rx.compile("\\s+")
	t = rx.sub(t, " ", true)
	return t.strip_edges()


## Match seeded vocabulary. Returns {cat, key} or {}.
## Phrases win first (longest-first); single words after.
## swear/insult_word/crude ALWAYS fire, even mid-sentence (HTML C50).
## "wtf" only fires standalone (HTML CANDIDATE28b).
static func match(text: String) -> Dictionary:
	var n := _norm(text)
	if n == "":
		return {}
	if _phrase_re == null:
		_phrase_re = RegEx.new()
		var parts := []
		for p in PHRASES:
			parts.append(_rx_escape(p))
		_phrase_re.compile("\\b(" + "|".join(parts) + ")\\b")
	var pm := _phrase_re.search(n)
	if pm:
		var pk := pm.get_string(1)
		if WORD_CATS.has(pk):
			return {"cat": String(WORD_CATS[pk]), "key": pk}
	var words := n.split(" ")
	# HTML C50: swear/insult_word/crude ALWAYS fire, even mid-sentence —
	# a crude word anywhere beats a milder earlier word ("im gonna piss"
	# reacts to "piss", not "im").
	for w in words:
		if w == "" or not WORD_CATS.has(w):
			continue
		var c := String(WORD_CATS[w])
		if c == "swear" or c == "insult_word" or c == "crude":
			return {"cat": c, "key": w}
	for w in words:
		if w == "" or not WORD_CATS.has(w):
			continue
		if w == "wtf" and words.size() > 1:
			continue
		return {"cat": String(WORD_CATS[w]), "key": w}
	return {}


## Full reaction: no-repeat pick from the faction pool, {word} filled.
## `used` is the caller-owned no-repeat ledger (mutated).
## Returns {text, cat, key} or {}.
static func react(text: String, faction: String,
		used: Dictionary) -> Dictionary:
	var m := match(text)
	if m.is_empty():
		return {}
	var cat: String = m["cat"]
	var key: String = m["key"]
	var by_cat: Dictionary = REACT.get(cat, {})
	var pool: Array = by_cat.get(faction, [])
	if pool.is_empty():
		pool = by_cat.get("gnome", [])
	if pool.is_empty():
		return {}
	var ukey := "ct:" + cat + ":" + faction
	var seen: Array = used.get(ukey, [])
	var avail := []
	for i in range(pool.size()):
		if not seen.has(i):
			avail.append(i)
	if avail.is_empty():
		avail = range(pool.size())
		seen.clear()
	var pick: int = avail[randi() % avail.size()]
	seen.append(pick)
	while seen.size() >= pool.size() and pool.size() > 1:
		seen.pop_front()
	used[ukey] = seen
	var line: String = pool[pick]
	line = line.replace("{word}", key)
	return {"text": line, "cat": cat, "key": key}
