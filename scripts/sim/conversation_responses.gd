## Cursing Gnomes — Conversation response pools.
## Ported from HTML fix79 MSGR_RESPONSES.
## Faction-specific response variants with Jeremy's signature writing.
## Tokens: {name} = NPC name, {ruler} = player name, {gold} = player gold,
##         {town} = NPC town, {newname} = newly set name.
class_name ConversationResponses
extends RefCounted


## Get response pool for intent + faction.
## Falls back to gnome if faction pool missing.
## HTML MSGR_RESPONSES has two shapes: faction-nested {"intent": {"gnome":
## [...]}} and flat {"c29_iyo_rage_1": [...]} (style-based, no faction split).
## Both are valid — flat pools return directly.
static func get_pool(intent: String, faction: String) -> Array:
	var raw: Variant = _POOLS.get(intent, null)
	if raw == null:
		return []
	if raw is Array:
		return raw
	var pools: Dictionary = raw
	if pools.is_empty():
		return []
	var fac_pool: Array = pools.get(faction, [])
	if fac_pool.is_empty():
		fac_pool = pools.get("gnome", [])
	return fac_pool


