## Decodes to the newline-separated word list. Caller splits + inserts.
static func packed_bytes() -> PackedByteArray:
	var joined := "".join(PackedStringArray(PACKED))
	var raw := Marshalls.base64_to_raw(joined)
	return raw.decompress(6000000, FileAccess.COMPRESSION_GZIP)
