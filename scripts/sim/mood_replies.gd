## Pick a random reply from a mood's pool. Unknown moods fall back
## to neutral (the baseline voice).
static func pick(mood: String) -> String:
	var pool: Array = REPLIES.get(mood, REPLIES["neutral"])
	if pool.is_empty():
		return ""
	return String(pool[randi() % pool.size()])


## Number of replies in a mood's pool (100+ by design).
static func pool_size(mood: String) -> int:
	var pool: Array = REPLIES.get(mood, [])
	return pool.size()


## All mood names that have reply pools.
static func moods() -> Array:
	return REPLIES.keys()
