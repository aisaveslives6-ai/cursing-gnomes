class_name Cliffs
extends RefCounted
## Cursing Gnomes — the Cliffs Update, ported from the HTML build.
##
## The HTML quantizes terrain elevation into discrete height levels (0-6)
## and builds five mechanics on top of them:
##   1. Climbable stepped mountains — levels, not smooth hills.
##   2. Visible cliff faces — rock rendered where levels drop.
##   3. High-ground combat edge — +15% damage per level of advantage.
##   4. Slope-aware pathfinding — |level diff| > 1 is a sheer cliff
##      (impassable); a +1 climb costs extra; descents are free.
##   5. Height shading on maps — higher ground reads lighter.
##
## HTML references (from ~/workspace/build-staging/fix79/index.html):
##   cgLevelForElev81  — elevation -> level formula (ported exactly).
##   cgLvlAt83         — level at a world point (level = round(lift/22)).
##   cgCliffBlocked    — |dL| > 1 blocks direct movement.
##   cgHighGroundMul83 — 1 + min(3, dL) * 0.15 when attacker is higher.
##   cgHillShade82     — RGB *= 1 + (L-1) * 0.045 for L > 1.
##   CLIFFS83          — A* slope costs: sheer = Infinity, +1 = +2.2.
##   cgUnitLiftTick83  — units ease toward their level's lift (no teleport).
##   CLIFFDETECT       — fleeing units slide along cliff edges.
##
## Godot notes:
##   - Levels live in map_data["levels"] (PackedByteArray, row-major,
##     MapGen.MAP_TILES grid), generated by MapGen.
##   - LIFT_PX_PER_LEVEL is Godot-scale (12 px on 32 px tiles). The HTML's
##     22 px step belongs to its 16000 px world; the mechanic (discrete
##     levels x lift, eased) is the port, the constant is scale-tuned.
##   - Lift is relative to town level (L1 = 0 lift) so buildings, props and
##     units on ordinary flat land sit exactly where they always did;
##     mountains rise above. Water (L0) is always 0.
##   - All helpers tolerate a missing/empty map_data (return neutral
##     values) so headless sim tests without a generated map keep passing.


## Discrete height levels, 0 (water/lowland) .. 6 (peaks).
const MAX_LEVEL := 6
## Elevation below this is water (level 0) — HTML's `e >= 0.30` gate.
const WATER_ELEV := 0.30
## Elevation band per level above water — HTML's 0.10 bands.
const LEVEL_BAND := 0.10
## Visual lift per level above town level, in world px.
const LIFT_PX_PER_LEVEL := 12.0
## A* uphill surcharge for a +1 climb — HTML's CLIFFS83_UPHILL (documented
## for the day Godot grows real pathfinding; steering uses try_step).
const UPHILL_COST := 2.2


## HTML's cgLevelForElev81, ported exactly (including the float-epsilon
## guard so exact band multiples don't read one level low).
static func level_for_elev(e: float) -> int:
	if not e >= WATER_ELEV:
		return 0
	var l: int = 1 + int(floor((e - WATER_ELEV) / LEVEL_BAND + 0.000001))
	return mini(l, MAX_LEVEL)


## Discrete level at a world position. 0 when no level grid is present.
static func level_at(map_data: Dictionary, world_pos: Vector2) -> int:
	var levels: PackedByteArray = map_data.get("levels", PackedByteArray())
	if levels.is_empty():
		return 0
	var size: Vector2i = map_data.get("size_tiles", Vector2i.ZERO)
	if size.x <= 0 or size.y <= 0:
		return 0
	if levels.size() < size.x * size.y:
		return 0
	var ts: int = maxi(1, int(map_data.get("tile_size", 32)))
	var tx: int = clampi(int(world_pos.x / float(ts)), 0, size.x - 1)
	var ty: int = clampi(int(world_pos.y / float(ts)), 0, size.y - 1)
	return levels[ty * size.x + tx]


## Fast level lookup with hoisted map arrays (zero dictionary gets).
## Identical result to level_at(map_data, pos) when the arrays come from
## that map_data (same guards). For the movement hot path.
static func level_at_fast(levels: PackedByteArray, sx: int, sy: int,
		tile: int, world_pos: Vector2) -> int:
	if levels.is_empty():
		return 0
	if sx <= 0 or sy <= 0:
		return 0
	if levels.size() < sx * sy:
		return 0
	var ts: int = maxi(1, tile)
	var tx: int = clampi(int(world_pos.x / float(ts)), 0, sx - 1)
	var ty: int = clampi(int(world_pos.y / float(ts)), 0, sy - 1)
	return levels[ty * sx + tx]


## Fast cliff-blocked check on hoisted arrays.
static func _cliff_blocked_fast(levels: PackedByteArray, sx: int, sy: int,
		tile: int, from_pos: Vector2, to_pos: Vector2) -> bool:
	var d: int = level_at_fast(levels, sx, sy, tile, to_pos) \
		- level_at_fast(levels, sx, sy, tile, from_pos)
	return d > 1 or d < -1


## Zero-dictionary-get version of try_step for the movement hot path.
## Identical movement result to try_step(map_data, pos, step).
static func try_step_fast(levels: PackedByteArray, sx: int, sy: int,
		tile: int, pos: Vector2, step: Vector2) -> Vector2:
	if levels.is_empty():
		return pos + step
	var full: Vector2 = pos + step
	if not _cliff_blocked_fast(levels, sx, sy, tile, pos, full):
		return full
	var x_only := Vector2(pos.x + step.x, pos.y)
	if not _cliff_blocked_fast(levels, sx, sy, tile, pos, x_only):
		return x_only
	var y_only := Vector2(pos.x, pos.y + step.y)
	if not _cliff_blocked_fast(levels, sx, sy, tile, pos, y_only):
		return y_only
	return pos


## Visual lift (px) for a world position. Eased per-node by the world sync
## (HTML's cgUnitLiftTick83: snap on first sight, ease after).
static func lift_at(map_data: Dictionary, world_pos: Vector2) -> float:
	var l: int = level_at(map_data, world_pos)
	if l <= 1:
		return 0.0
	return float(l - 1) * LIFT_PX_PER_LEVEL


## HTML's cgCliffBlocked: stepping across more than one level is a sheer
## cliff — impassable. A single step up/down is climbable.
static func cliff_blocked(map_data: Dictionary, from_pos: Vector2,
		to_pos: Vector2) -> bool:
	var d: int = level_at(map_data, to_pos) - level_at(map_data, from_pos)
	return d > 1 or d < -1


## HTML's cgHighGroundMul83: attacking down from a higher level hits
## harder — +15% per level of advantage, capped at 3 levels (+45%).
## No uphill penalty; splash (no attacker position) is unaffected.
static func high_ground_mult(map_data: Dictionary, attacker_pos: Vector2,
		target_pos: Vector2) -> float:
	var d: int = level_at(map_data, attacker_pos) \
		- level_at(map_data, target_pos)
	if d > 0:
		return 1.0 + float(mini(d, 3)) * 0.15
	return 1.0


## Height-shading multiplier — HTML's cgHillShade82: higher ground reads
## lighter. Applied to terrain color channels (clamped by the caller).
static func hill_shade_mult(level: int) -> float:
	if level > 1:
		return 1.0 + float(level - 1) * 0.045
	return 1.0


## Slope-aware step — HTML's CLIFFDETECT: never walk off a sheer cliff.
## Tries the full step, then slides along the edge (x-only, then y-only)
## before giving up and staying put.
static func try_step(map_data: Dictionary, pos: Vector2,
		step: Vector2) -> Vector2:
	if map_data.is_empty() or map_data.get("levels", PackedByteArray()).is_empty():
		return pos + step
	var full: Vector2 = pos + step
	if not cliff_blocked(map_data, pos, full):
		return full
	var x_only := Vector2(pos.x + step.x, pos.y)
	if not cliff_blocked(map_data, pos, x_only):
		return x_only
	var y_only := Vector2(pos.x, pos.y + step.y)
	if not cliff_blocked(map_data, pos, y_only):
		return y_only
	return pos
